{
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "https://footage-to-story.example/schemas/2.0.0/common.schema.json#/$defs/schema_version"
    },
    "job_id": {
      "$ref": "https://footage-to-story.example/schemas/2.0.0/common.schema.json#/$defs/identifier"
    },
    "locks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "enum": [
              "selects",
              "edit-plan"
            ]
          },
          "item_id": {
            "$ref": "https://footage-to-story.example/schemas/2.0.0/common.schema.json#/$defs/identifier"
          },
          "item": {},
          "source_id": {
            "$ref": "https://footage-to-story.example/schemas/2.0.0/common.schema.json#/$defs/identifier"
          },
          "source_sha256": {
            "$ref": "https://footage-to-story.example/schemas/2.0.0/common.schema.json#/$defs/sha256"
          },
          "artifact_sha256": {
            "$ref": "https://footage-to-story.example/schemas/2.0.0/common.schema.json#/$defs/sha256"
          }
        },
        "required": [
          "stage",
          "item_id",
          "item",
          "source_id",
          "source_sha256",
          "artifact_sha256"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "stage": {
                  "const": "selects"
                }
              }
            },
            "then": {
              "properties": {
                "item": {
                  "$ref": "https://footage-to-story.example/schemas/2.0.0/selects.schema.json#/properties/items/items"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "stage": {
                  "const": "edit-plan"
                }
              }
            },
            "then": {
              "properties": {
                "item": {
                  "$ref": "https://footage-to-story.example/schemas/2.0.0/edit-plan.schema.json#/properties/items/items"
                }
              }
            }
          }
        ]
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "enum": [
              "selects",
              "edit-plan"
            ]
          },
          "item_id": {
            "$ref": "https://footage-to-story.example/schemas/2.0.0/common.schema.json#/$defs/identifier"
          },
          "action": {
            "enum": [
              "LOCK",
              "UNLOCK"
            ]
          },
          "user_message": {
            "$ref": "https://footage-to-story.example/schemas/2.0.0/common.schema.json#/$defs/nonblank_text"
          },
          "context_reference": {
            "$ref": "https://footage-to-story.example/schemas/2.0.0/common.schema.json#/$defs/nonblank_text"
          }
        },
        "required": [
          "stage",
          "item_id",
          "action",
          "user_message",
          "context_reference"
        ],
        "additionalProperties": false
      }
    },
    "previous_sha256": {
      "anyOf": [
        {
          "$ref": "https://footage-to-story.example/schemas/2.0.0/common.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "locks",
    "events",
    "previous_sha256"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://footage-to-story.example/schemas/2.0.0/locks.schema.json",
  "title": "Observed historical lock snapshots"
}
