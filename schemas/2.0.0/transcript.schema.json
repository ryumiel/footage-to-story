{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://footage-to-story.example/schemas/2.0.0/transcript.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "https://footage-to-story.example/schemas/2.0.0/common.schema.json#/$defs/schema_version"
    },
    "job_id": {
      "$ref": "https://footage-to-story.example/schemas/2.0.0/common.schema.json#/$defs/identifier"
    },
    "source_id": {
      "$ref": "https://footage-to-story.example/schemas/2.0.0/common.schema.json#/$defs/identifier"
    },
    "source_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "language": {
      "$ref": "https://footage-to-story.example/schemas/2.0.0/common.schema.json#/$defs/nonblank_text"
    },
    "content_kind": {
      "enum": [
        "QUOTATION",
        "SUMMARY",
        "USER_NOTE",
        "INFERENCE",
        "EXTERNAL_FACT"
      ]
    },
    "time_origin_ms": {
      "const": 0
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cue_id": {
            "$ref": "https://footage-to-story.example/schemas/2.0.0/common.schema.json#/$defs/identifier"
          },
          "raw_index": {
            "type": "integer",
            "minimum": 1
          },
          "start_ms": {
            "$ref": "https://footage-to-story.example/schemas/2.0.0/common.schema.json#/$defs/nonnegative_integer"
          },
          "end_ms": {
            "$ref": "https://footage-to-story.example/schemas/2.0.0/common.schema.json#/$defs/positive_integer"
          },
          "text": {
            "$ref": "https://footage-to-story.example/schemas/2.0.0/common.schema.json#/$defs/nonblank_text"
          }
        },
        "required": [
          "cue_id",
          "raw_index",
          "start_ms",
          "end_ms",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "source_id",
    "source_sha256",
    "manifest_sha256",
    "raw_sha256",
    "language",
    "content_kind",
    "time_origin_ms",
    "cues"
  ],
  "additionalProperties": false
}
