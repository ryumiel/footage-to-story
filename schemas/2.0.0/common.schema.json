{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://footage-to-story.example/schemas/2.0.0/common.schema.json",
  "title": "Footage to Story common contract definitions",
  "$comment": "Reference library only; do not use this resource as a standalone document validator.",
  "$defs": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "not": {
        "pattern": "\\s"
      }
    },
    "nonblank_text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "rational_rate": {
      "type": "object",
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "den": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "num",
        "den"
      ],
      "additionalProperties": false
    },
    "millisecond_range": {
      "type": "object",
      "properties": {
        "start_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "start_ms",
        "end_ms"
      ],
      "additionalProperties": false
    },
    "identifier_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonblank_text"
      },
      "minItems": 0
    },
    "scores": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false,
      "description": "The only dynamic-key object. Keys name editorial criteria; scores are relative values in [0,1], not calibrated probabilities.",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "not": {
          "pattern": "\\s"
        }
      }
    }
  }
}
